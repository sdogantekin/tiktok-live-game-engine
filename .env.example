# Server bind address. Keep on loopback; the operator interface must not be exposed publicly.
HOST=127.0.0.1
PORT=3001

# The game to start with: mahalle-halayi or taki-takma (the operator can switch while the game is stopped).
# GAME=mahalle-halayi

# Set to on to let the operator read a real TikTok LIVE (unofficial access; see docs/running-a-stream.md).
# TIKTOK_LIVE=off

# Optional key of the signing service the TikTok connector depends on. A secret: never commit it.
# EULER_API_KEY=
